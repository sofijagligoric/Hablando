<Page x:Class="Hablando.View.LevelOnePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Hablando.View"
      xmlns:util="clr-namespace:Hablando.Util"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      Title="LevelOnePage">

    <Page.Resources>

        <util:IntToColorConverter x:Key="IntToColorConverter" />
    </Page.Resources>


    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,5">
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource TitleColor}" />

            </Grid.Background>
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <Label Content="Bodovi:"
                       HorizontalAlignment="Left"
                       FontSize="15"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"
                       Foreground="{DynamicResource LightBackgroundColorBrush}" />
                <TextBlock Text="{Binding Points}"
                           HorizontalAlignment="Left"
                           FontSize="15"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="{DynamicResource LightBackgroundColorBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Label Grid.Column="2"
                       Content="Preostalo vrijeme:"
                       HorizontalAlignment="Right"
                       FontSize="15"
                       VerticalAlignment="Center"
                       Margin="0,0,0,0"
                       Foreground="{DynamicResource LightBackgroundColorBrush}" />
                <TextBlock Text="{Binding TimeRemaining, StringFormat={}{0:mm\\:ss}}"
                           HorizontalAlignment="Right"
                           FontSize="15"
                           VerticalAlignment="Center"
                           Margin="5,0,15,0"
                           Foreground="{DynamicResource LightBackgroundColorBrush}" />
            </StackPanel>
            <Label Grid.Column="1"
                   Content="Level 1"
                   HorizontalAlignment="Center"
                   FontSize="25"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource LightBackgroundColorBrush}" />


        </Grid>



        <Grid Grid.Row="1"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Margin="0,10,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Label Grid.Row="1"
                   Content="Izaberite riječi koje imaju isto značenje."
                   HorizontalAlignment="Center"
                   FontSize="22"
                   Margin="0,0,0,20"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TitleColorBrush}" />
            <Button Grid.Row="0"
                    Style="{DynamicResource RestartButtonStyle}"
                    ToolTip="Restartuj igru"
                    Command="{Binding RestartCommand}"
                    HorizontalAlignment="Right"
                    Margin="0,0,50,10">
                <fa:ImageAwesome Icon="RotateRight"
                                 Width="20"
                                 Height="20"
                                 Foreground="White" />
            </Button>
        </Grid>

        <Border BorderThickness="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Grid.Row="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="#822319"
                                  Offset="0" />
                    <GradientStop Color="#380d08"
                                  Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Direction="315"
                                  ShadowDepth="7"
                                  BlurRadius="10"
                                  Opacity="0.5" />
            </Border.Effect>
            <Grid Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding SerbianWords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Text}"
                                    Style="{DynamicResource Level1OptionStyle}"
                                    Command="{Binding DataContext.SelectWordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Background="{Binding IsCorrect, Converter={StaticResource IntToColorConverter}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding SpanishWords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Text}"
                                    Style="{DynamicResource Level1OptionStyle}"
                                    Command="{Binding DataContext.SelectWordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Background="{Binding IsCorrect, Converter={StaticResource IntToColorConverter}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>

        </Border>

        <Button Content="Odustani"
                Grid.Row="3"
                Click="CancelButtonClick"
                Margin="0,20,0,20"
                Style="{DynamicResource ProceedButtonStyle}" />


    </Grid>
</Page>
