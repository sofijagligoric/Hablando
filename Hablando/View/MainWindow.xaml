<Window x:Class="Hablando.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hablando.View"
        mc:Ignorable="d"
        Title="Hablando" Height="700" Width="800"
        WindowStartupLocation="CenterScreen">

    <Border BorderThickness="0">

        <Border.Background>
            <LinearGradientBrush StartPoint="0,1"
                                 EndPoint="1,0">
                <GradientStop Color="{DynamicResource BackgroundColor1}"
                              Offset="0" />
                <GradientStop Color="{DynamicResource BackgroundColor2}"
                              Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>


            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden" />
        </Grid>
    </Border>
    
</Window>
