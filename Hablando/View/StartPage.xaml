    <Grid>
        <Grid>
            <Image Source="/Images/Background.jpg"
                   Stretch="Fill">
                <Image.Effect>
                    <BlurEffect Radius="10" />
                </Image.Effect>
            </Image>
        </Grid>

        <!-- Sadržaj koji nije zamagljen -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <!--
            <Grid.Background>
                    <ImageBrush ImageSource="/Images/Background.jpg" />
                </Grid.Background>
                <Grid.Effect>
                    <BlurEffect Radius="0" />
                </Grid.Effect>
            -->



            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,30,0,20"
                        >
                <Label FontSize="80"
                       Content="Hablando" 
                       HorizontalAlignment="Center"
                       FontFamily="Segoe Print"
                       Foreground="{DynamicResource TitleColorBrush}"
                       FontWeight="Bold"/>
                <Label FontSize="30"
                       Content="Zabavi se i nauči!"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe Print"
                       Foreground="{DynamicResource TitleColorBrush}" 
                       FontWeight="Bold"/>

            </StackPanel>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Width="auto"
                        Margin="0,0,0,20"
                        Visibility="{Binding IsInputVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                <Label FontSize="30"
                       Content="Ime:"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TitleColorBrush}"
                       FontWeight="DemiBold" />
                <TextBox x:Name="ImeTextBox"
                         Width="230"
                         Height="40"
                         Background="Transparent"
                         FontSize="20"
                         Margin="10,0,10,0"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         Text="{Binding Player, UpdateSourceTrigger=PropertyChanged}"
                         
                GotFocus="ImeTextBox_GotFocus"
                         LostFocus="ImeTextBox_LostFocus"
                         Style="{DynamicResource HintedTextBoxStyle}"/>
                <Button Content="Sačuvaj"
                        Command="{Binding SavePlayerCommand}"
                        IsDefault="True"
                        Style="{DynamicResource ProceedButtonStyle}" />
            </StackPanel>

            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="auto"
                        Grid.Row="1"
                        Visibility="{Binding IsGameVisible, Converter={StaticResource BoolToVisibilityConverter}}" >
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Igrač:"
                               HorizontalAlignment="Left"
                               FontSize="25"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"
                               FontWeight="DemiBold"
                               Foreground="{DynamicResource TitleColorBrush}" />
                        <TextBlock Text="{Binding Player}"
                                   HorizontalAlignment="Left"
                                   FontSize="25"
                                   VerticalAlignment="Center"
                               FontWeight="DemiBold"
                               Margin="10,0,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TitleColorBrush}" />
           
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label Content="Bodovi:"
                               HorizontalAlignment="Left"
                           FontWeight="DemiBold"
                           FontSize="25"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"
                               Foreground="{DynamicResource TitleColorBrush}" />
                        <TextBlock Text="{Binding Points}"
                                   HorizontalAlignment="Left"
                                   FontSize="25"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                               FontWeight="DemiBold"
                               TextWrapping="Wrap"
                                   Foreground="{DynamicResource TitleColorBrush}" />

                    </StackPanel>
                    <Button Content="Novi igrač"
                        Command="{Binding NewPlayerCommand}"
                        Style="{DynamicResource ProceedButtonStyle}"
                            Margin="0,0,0,10"/>
                </StackPanel>
               

           
            <StackPanel Grid.Row="2"
                        Width="auto"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button Content="Level 1"
                        Style="{DynamicResource Level1ButtonStyle}"
                        Click="Level1ButtonClick" />
                <Button  Content="Level 2"
                         Style="{DynamicResource Level2ButtonStyle}"
                         Click="Level2ButtonClick"/>
                <Button  Content="Level 3"
                         Style="{DynamicResource Level3ButtonStyle}"
                         Click="Level3ButtonClick"/>

            </StackPanel>

        </Grid>
    </Grid>
    <!--</Border>
    </Border>-->
</Page>
