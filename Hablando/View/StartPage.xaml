            <Grid>
               
                <Grid.Background>
                    <ImageBrush ImageSource="/Images/Background.jpg" />
                </Grid.Background>
                <Grid.Effect>
                    <BlurEffect Radius="0" />
                </Grid.Effect>
                
                

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Width="auto">
                    <TextBox  Style="{DynamicResource HintedTextBoxStyle}"
                              Width="250"
                              Height="40"
                              materialDesign:HintAssist.Hint="Unesite ime..." />
                    <Button Content="Sačuvaj"
                            Style="{DynamicResource ProceedButtonStyle}" />

                </StackPanel>
                <StackPanel Grid.Row="1"
                            Width="auto">

                    <Button Content="Level 1"
                            Style="{DynamicResource Level1ButtonStyle}" />
                    <Button  Content="Level 2"
                             Style="{DynamicResource Level2ButtonStyle}" />
                    <Button  Content="Level 3"
                             Style="{DynamicResource Level3ButtonStyle}" />

                </StackPanel>

            </Grid>
        <!--</Border>
    </Border>-->
