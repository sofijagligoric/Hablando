<Window x:Class="Hablando.View.GameoverWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:local="clr-namespace:Hablando.View"
         mc:Ignorable="d"
         Title="Game over"
         Height="200"
         Width="450"
         WindowStartupLocation="CenterScreen"
         ResizeMode="NoResize">

    <Border BorderThickness="0">

        <Border.Background>
            <LinearGradientBrush StartPoint="0,1"
                                 EndPoint="1,0">
                <GradientStop Color="#dbd814"
                              Offset="0" />
                <GradientStop Color="#cfa00c"
                              Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Vertical"
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,10,0,10">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="18"
                           FontWeight="DemiBold"
                           Text="Vrijeme isteklo!"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource TitleColorBrush}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="15"
                               Text="Osvojeni bodovi: "
                               FontWeight="DemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,5,0"
                               Foreground="{DynamicResource TitleColorBrush}" />
                    <TextBlock x:Name="MessageTextBlock"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontWeight="DemiBold"
                               FontSize="15"
                               Text="{Binding Points}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TitleColorBrush}" />

                </StackPanel>

            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,10,0,10">
                <Button Content="Početna stranica"
                        Click="HomeButtonClicked"
                        Margin="0,0,10,0"
                        Style="{DynamicResource ProceedButtonStyle}"
                        Width="auto" />
                <Button Content="Naredni nivo"
                        Click="NextLevelClicked"
                        Margin="0,0,0,0"
                        Width="auto"
                        IsEnabled="{Binding HasNextLevel}"
                        Style="{DynamicResource ProceedButtonStyle}" />

            </StackPanel>
        </Grid>
    </Border>
</Window>